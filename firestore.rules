rules_version = '2';

// Backstop only: the API (via the Admin SDK, which bypasses these rules) is
// the primary authorization gate. These rules stop a compromised or
// malicious client from talking to Firestore directly with the client SDK.
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if request.auth != null;
      // Admin-only write. Field/shape validation is handled by the API (Zod);
      // rules enforce authorization (who can write), not payload shape.
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /users/{userId} {
      // A user may read their own profile; admins may read any profile.
      // Role assignment is server-only, so no client write path exists.
      allow read: if request.auth != null &&
        (request.auth.uid == userId || request.auth.token.role == 'admin');
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
